# Copy this file to .env for local development.
# On Render, set these in the service's Environment tab instead —
# render.yaml already wires DATABASE_URL and JWT_SECRET automatically.

DATABASE_URL=postgresql://localhost/himate_dev
JWT_SECRET=replace-with-a-long-random-string

# Africa's Talking (OTP SMS) — leave blank locally to use dev-mode console logging
AT_USERNAME=
AT_API_KEY=
